-- 🧠 Functions
local function isEnemy(vPlayer)
    if vPlayer.Team ~= nil and plr.Team ~= nil then
        return vPlayer.Team ~= plr.Team
    end
    return true
end

local function getClosest()
    local closest = nil
    local shortest = math.huge
    
    for _, v in pairs(players:GetPlayers()) do
        if v ~= plr and isEnemy(v) and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local head = v.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - fovCircle.Position).Magnitude
                    local myHead = plr.Character and plr.Character:FindFirstChild("Head")
                    local dist3D = myHead and (head.Position - myHead.Position).Magnitude or math.huge
                    
                    if distFromCenter <= fovRadius and dist3D < shortest then
                        shortest = dist3D
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

local function applyESP(vPlayer)
    if vPlayer == plr then return end
    
    local function setupCharacter(char)
        if not char then return end
        
        local oldHighlight = char:FindFirstChild("ESPHighlight")
        if oldHighlight then oldHighlight:Destroy() end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Enabled = espEnabled
        
        if isEnemy(vPlayer) then
            highlight.FillColor = enemyColor
            highlight.OutlineColor = enemyColor
        else
            highlight.FillColor = teamColor
            highlight.OutlineColor = teamColor
        end
        
        highlight.Parent = char
    end

    if vPlayer.Character then setupCharacter(vPlayer.Character) end
    vPlayer.CharacterAdded:Connect(setupCharacter)
    vPlayer:GetPropertyChangedSignal("Team"):Connect(function()
        if vPlayer.Character then setupCharacter(vPlayer.Character) end
    end)
end

for _, v in pairs(players:GetPlayers()) do applyESP(v) end
players.PlayerAdded:Connect(applyESP)

-- ⌨️ Inputs
uis.InputBegan:Connect(function(input, gpe)
    if input.KeyCode == Enum.KeyCode.RightShift then
        mainFrame.Visible = not mainFrame.Visible
        return
    end

    if isKeybinding then
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
            aimKey = input.KeyCode
            aimKeyType = "KeyCode"
            keybindBtn.Text = "Lock Key: " .. tostring(input.KeyCode.Name)
            isKeybinding = false
            keybindBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        elseif input.UserInputType ~= Enum.UserInputType.Keyboard and input.UserInputType ~= Enum.UserInputType.Focus then
            aimKey = input.UserInputType
            aimKeyType = "UserInputType"
            keybindBtn.Text = "Lock Key: " .. tostring(input.UserInputType.Name)
            isKeybinding = false
            keybindBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        end
        return
    end

    if gpe then return end

    if aimKeyType == "UserInputType" and input.UserInputType == aimKey then
        aiming = true
    elseif aimKeyType == "KeyCode" and input.KeyCode == aimKey then
        aiming = true
    end
end)

uis.InputEnded:Connect(function(input)
    if aimKeyType == "UserInputType" and input.UserInputType == aimKey then
        aiming = false
    elseif aimKeyType == "KeyCode" and input.KeyCode == aimKey then
        aiming = false
    end
end)

rs.RenderStepped:Connect(function()
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    if aiming and aimbotEnabled then
        local target = getClosest()
        if target then
            cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position)
        end
    end
end)
